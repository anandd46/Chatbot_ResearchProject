# ============================================================
# Smart College AI Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ----- Application -----
APP_NAME="Smart College AI Chatbot"
APP_ENV=development
# development | staging | production
DEBUG=true

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://chatbot_user:changeme@localhost:5432/chatbot_db
# For Docker Compose, use: postgresql+asyncpg://chatbot_user:changeme@postgres:5432/chatbot_db

# ----- JWT / Security -----
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Password Policy -----
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ----- Rate Limiting -----
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=100/minute

# ----- NLP / AI -----
NLP_CONFIDENCE_THRESHOLD=0.35
OOD_CONFIDENCE_THRESHOLD=0.10
# Score fusion defaults (must sum to 1.0)
SCORE_WEIGHT_TFIDF=0.40
SCORE_WEIGHT_WORD_ORDER=0.25
SCORE_WEIGHT_INTENT=0.20
SCORE_WEIGHT_KEYWORD=0.15

# ----- Admin Seed Account -----
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME="System Administrator"

# ----- College Branding -----
COLLEGE_NAME="Greenfield Institute of Technology"
COLLEGE_SHORT_NAME="GIT"

# ----- CORS -----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ----- Optional: External LLM (abstraction layer) -----
# Leave blank to use local retrieval pipeline only
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=local
# local | openai | gemini
